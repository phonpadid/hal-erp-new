sakai-vue/

# TypeScript incremental build info (build artifact, never committed)
*.tsbuildinfo
data/
# Database dumps taken before a migration or an import. Customer data — never committed.
backup/
*.dump

# Playwright storage state — live session tokens for real accounts. Never committed.
.auth/
# Playwright MCP session artifacts: screenshots, snapshots, console logs.
.playwright-mcp/

# Dev server logs + pid files written by ./start.sh
logs/

# Playwright run artifacts: per-failure traces and the HTML report. Regenerated by every run,
# and a failure's context is only meaningful next to the run that produced it.
back/test-results/
back/playwright-report/
