node_modules
dist
.env
coverage

# Screenshots from dev/UX runs. Regenerated on demand; the repo is not an image host.
# Front-end assets under front-end/ are real product files and stay tracked.
*.png
!front-end/**/*.png
back/node_modules
front-end/node_modules
front-end/.env
back/.env
back/dist
front-end/dist

# The deploy keeps the outgoing build next to the incoming one for a hand rollback, and stages the
# incoming one before it swaps. Both live only on the production host; `dist` above does not cover
# either name. Listed so the host's checkout stays clean and a stray `git clean` cannot eat the
# rollback copy — see back/README.md.
dist.prev
dist.broken
.deploy-incoming

sakai-vue/
front-end/.env.local
front-end/.env.test
front-end/.env.test.bak


# TypeScript incremental build info (build artifact, never committed)
*.tsbuildinfo
data/
# Database dumps taken before a migration or an import. Customer data — never committed.
backup/
*.dump

# Playwright storage state — live session tokens for real accounts. Never committed.
.auth/
# Playwright MCP session artifacts: screenshots, snapshots, console logs.
.playwright-mcp/

# Dev server logs + pid files written by ./start.sh
logs/

# Playwright run artifacts: per-failure traces and the HTML report. Regenerated by every run,
# and a failure's context is only meaningful next to the run that produced it.
back/test-results/
back/playwright-report/
app