# ── Database (PostgreSQL 15+) ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=erp
DB_PASSWORD=erp
DB_NAME=erp

# ── Auth ────────────────────────────────────────────────────────────────────
# Symmetric secret used to sign/verify the company-context JWT.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h
# Initial password for login accounts created via the employee-admin "create account"
# flow. The admin never types a password; the server hashes this value. Required for that
# flow (account creation fails closed if unset). Rotate/reset per user after onboarding.
USER_PASSWORD=change-me-initial-password

# ── Object storage / CDN (AWS S3 + CloudFront) — attachments only, never blobs in DB
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET_NAME=
AWS_DISTRIBUTIONS_ID=
AWS_CLOUDFRONT_DISTRIBUTION_DOMAIN_NAME=
# Local MinIO (docker-compose): browser uploads bytes directly via presigned URLs.
# For MinIO set S3_ENDPOINT + path-style; for real AWS leave S3_ENDPOINT blank.
#   S3_ENDPOINT=http://localhost:9000
#   AWS_ACCESS_KEY_ID=minioadmin / AWS_SECRET_ACCESS_KEY=minioadmin / AWS_S3_BUCKET_NAME=erp-attachments
# The bucket needs a CORS rule allowing PUT/GET from the web origin so the browser can
# upload/download directly, e.g. AllowedOrigins=[http://localhost:5173],
# AllowedMethods=[PUT,GET], AllowedHeaders=[*].
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=true
S3_URL_TTL_SECONDS=300
S3_MAX_UPLOAD_MB=25

# remove.bg API key for server-side signature background removal (keep secret; do not expose to the client).
REMOVE_BG_API_KEY=

# ── Redis (cache / queues) ────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_DB=0

# ── Mail (SMTP — notifications) ───────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
# Base URL of the web app, used to build emailed links (password reset, email verification).
WEB_BASE_URL=http://localhost:5173

# ── App ─────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Bootstrap (first run on a database with no accounts) ─────────────────────
# Read ONLY by `pnpm --filter back bootstrap:admin`, never by the running application. That
# command creates the first company and the first administrator on a database that has neither,
# and refuses once any account exists. See "First run on production" in README.md.
#
# Left blank on purpose. Nothing here may default: a default administrator password is a published
# administrator password. Set them from a file or a `read -s` prompt rather than inline, so the
# password does not land in shell history, and change it through the product after signing in.
BOOTSTRAP_USERNAME=
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_COMPANY_CODE=
BOOTSTRAP_COMPANY_NAME=
# Must match an active `currency` row — `seed:prod` seeds LAK, THB and USD.
BOOTSTRAP_CURRENCY_CODE=
