{
  "name": "back",
  "version": "0.0.1",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "description": "Multi-Company ERP — Approval + Budget + Quota (backend)",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build && node scripts/assert-dist-assets.cjs",
    "build:host": "nest build -p tsconfig.build-host.json && node scripts/assert-dist-assets.cjs",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test",
    "boot:check": "ts-node -P tsconfig.json scripts/boot-check.ts",
    "permissions:sync": "ts-node -P tsconfig.json scripts/permissions-sync.ts",
    "permissions:check": "ts-node -P tsconfig.json scripts/permissions-check.ts",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "golive:check": "ts-node -P tsconfig.json scripts/golive-check.ts",
    "golive:apply": "ts-node -P tsconfig.json scripts/golive-apply.ts",
    "seed:prod": "ts-node -P tsconfig.json scripts/seed-essentials.ts",
    "bootstrap:admin": "ts-node -P tsconfig.json scripts/bootstrap-admin.ts",
    "import:accounts": "ts-node -P tsconfig.json scripts/import-accounts.ts",
    "prepare:budget-plan": "ts-node -P tsconfig.json scripts/prepare-budget-plan.ts",
    "import:budget-plan": "ts-node -P tsconfig.json scripts/import-budget-plan.ts",
    "prepare:spend-history": "ts-node -P tsconfig.json scripts/prepare-spend-history.ts",
    "import:spend-history": "ts-node -P tsconfig.json scripts/import-spend-history.ts",
    "orm": "mikro-orm",
    "migration:create": "mikro-orm migration:create",
    "migration:up": "mikro-orm migration:up",
    "schema:dump": "mikro-orm schema:update --dump",
    "seed": "mikro-orm seeder:run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@erp/shared": "workspace:*",
    "@mikro-orm/core": "^6.4.16",
    "@mikro-orm/migrations": "^6.4.16",
    "@mikro-orm/nestjs": "^6.1.1",
    "@mikro-orm/postgresql": "^6.4.16",
    "@mikro-orm/seeder": "^6.4.16",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "decimal.js": "^10.4.3",
    "multer": "2.1.1",
    "nodemailer": "^6.9.16",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.19.1",
    "pdfmake": "^0.2.23",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@mikro-orm/cli": "^6.4.16",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@playwright/test": "^1.49.1",
    "@swc/core": "^1.10.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^6.4.17",
    "@types/passport-jwt": "^4.0.1",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "unplugin-swc": "^1.5.1",
    "vitest": "^3.0.5"
  },
  "mikro-orm": {
    "useTsNode": true,
    "configPaths": [
      "./src/mikro-orm.config.ts",
      "./dist/mikro-orm.config.js"
    ]
  }
}
